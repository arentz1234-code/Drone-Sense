# Google Gemini API Key (required for AI analysis)
# FREE: 15 requests/min, 1 million tokens/month
# Get key at: https://aistudio.google.com/apikey
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# RapidAPI Key (for property data - RealtyMole API)
# FREE: 50 requests/month
# Get key at: https://rapidapi.com/realtymole/api/realty-mole-property-api
RAPIDAPI_KEY=your_rapidapi_key_here

# TomTom API Key (for traffic data)
# FREE: 2,500 requests/day
# Get key at: https://developer.tomtom.com/
TOMTOM_API_KEY=your_tomtom_api_key_here

# College Scorecard API Key (for university enrollment data)
# FREE: 1,000 requests/hour
# Get key at: https://api.data.gov/signup/
COLLEGE_SCORECARD_API_KEY=your_data_gov_api_key_here

# Census API Key (optional - for demographics data)
# FREE: 500 requests/day without key, unlimited with key
# Get key at: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=your_census_api_key_here

# Optional: Google Maps Embed API Key (for satellite map view)
# FREE: Unlimited embeds
# Get key at: https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# ============================================
# NEW DATA SOURCES (All Optional - have fallbacks)
# ============================================

# Walk Score API Key (for walkability/transit scores)
# FREE: 5,000 requests/day
# Get key at: https://www.walkscore.com/professional/api-sign-up.php
# Note: Falls back to OSM-based estimates if not configured
WALKSCORE_API_KEY=your_walkscore_api_key_here

# FBI Crime Data API Key (for crime statistics)
# FREE: Unlimited
# Get key at: https://crime-data-explorer.fr.cloud.gov/api
# Note: Falls back to state-level UCR estimates if not configured
FBI_API_KEY=your_fbi_api_key_here

# ============================================
# FREE APIs (No keys required)
# ============================================
# The following data sources are free and don't require API keys:
# - Census County Business Patterns (vacancy/saturation data)
# - Census Building Permits Survey (development momentum)
# - FEMA Flood Zones
# - NWI Wetlands
# - EPA Brownfields/Superfund
# - OpenStreetMap (nearby businesses, road data)
# - TomTom Isochrones (uses your existing TomTom key)
